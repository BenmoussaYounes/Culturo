{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "dart format ."
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "dart analyze"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dart analyze *)"
    ]
  }
}
